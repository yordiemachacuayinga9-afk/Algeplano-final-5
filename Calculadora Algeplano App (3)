<!DOCTYPE html><html lang="es"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8"><link rel="stylesheet" type="text/css" href="cid:css-60718d01-704b-4ece-99ba-6f239827179d@mhtml.blink" />
  
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Calculadora Algeplano App</title>
  <meta name="theme-color" content="#0f172a">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="Algeplano">
  <link rel="manifest" href="data:application/manifest+json;charset=utf-8,%7B%22name%22%3A%22Calculadora%20Algeplano%22%2C%22short_name%22%3A%22Algeplano%22%2C%22start_url%22%3A%22.%22%2C%22display%22%3A%22standalone%22%2C%22background_color%22%3A%22%230f172a%22%2C%22theme_color%22%3A%22%230f172a%22%7D">
  
</head>
<body>

  <h1>Calculadora Algeplano App</h1>
  <button id="btn-install">📲 Instalar App en Google Chrome</button>

  <div class="calc-panel">
    <div class="input-group">
      <select id="op-type">
        <option value="mult">Multiplicar: (a) × (b)</option>
        <option value="pnot">Producto Notable: (Binomio / Dif. Cuadrados)</option>
        <option value="fact">Factorizar: Polinomio</option>
        <option value="div">Dividir: (Dividendo) ÷ (Divisor)</option>
        <option value="sum">Sumar: (A) + (B)</option>
        <option value="rest">Restar: (A) - (B)</option>
        <option value="eq">Ecuación Lineal: Ax + B = Cx + D</option>
        <option value="quad">Ecuación Cuadrática: ax² + bx + c = 0</option>
        <option value="sys2">Sistema 2x2: Ax + By = C | Dx + Ey = F</option>
      </select>
    </div>

    <!-- Modos de Entrada -->
    <div id="input-mult" class="input-group">
      <input type="text" id="m-fact1" placeholder="Factor 1 (ej: x+2)" value="x+2">
      <span>×</span>
      <input type="text" id="m-fact2" placeholder="Factor 2 (ej: x+1)" value="x+1">
    </div>

    <div id="input-pnot" class="input-group" style="display:none;">
      <select id="pn-type">
        <option value="sq">Binomio al Cuadrado: (x + a)²</option>
        <option value="diff">Diferencia de Cuadrados: (x + a)(x - a)</option>
        <option value="term">Término Común: (x + a)(x + b)</option>
      </select>
      <input type="number" id="pn-a" placeholder="a (ej: 3)" value="3" style="width: 80px;">
      <input type="number" id="pn-b" placeholder="b (ej: 2)" value="2" style="width: 80px;">
    </div>

    <div id="input-fact" class="input-group" style="display:none;">
      <input type="text" id="f-poly" placeholder="Polinomio (ej: x^2+3x+2)" value="x^2+3x+2">
    </div>

    <div id="input-div" class="input-group" style="display:none;">
      <input type="text" id="d-num" placeholder="Dividendo (ej: x^2+3x+2)" value="x^2+3x+2">
      <span>÷</span>
      <input type="text" id="d-den" placeholder="Divisor (ej: x+1)" value="x+1">
    </div>

    <div id="input-sum" class="input-group" style="display:none;">
      <input type="text" id="s-exp1" placeholder="Expresión 1 (ej: 2x+3)" value="2x+3">
      <span>+</span>
      <input type="text" id="s-exp2" placeholder="Expresión 2 (ej: x+4)" value="x+4">
    </div>

    <div id="input-rest" class="input-group" style="display:none;">
      <input type="text" id="r-exp1" placeholder="Expresión 1 (ej: 3x+5)" value="3x+5">
      <span>-</span>
      <input type="text" id="r-exp2" placeholder="Expresión 2 (ej: x+2)" value="x+2">
    </div>

    <div id="input-eq" class="input-group" style="display:none;">
      <input type="text" id="eq-lhs" placeholder="Lado Izq. (ej: 3x+2)" value="3x+2">
      <span>=</span>
      <input type="text" id="eq-rhs" placeholder="Lado Der. (ej: x+8)" value="x+8">
    </div>

    <div id="input-quad" class="input-group" style="display:none;">
      <input type="text" id="q-expr" placeholder="Ecuación (ej: x^2 - 5x + 6 = 0)" value="x^2 - 5x + 6 = 0">
    </div>

    <div id="input-sys2" class="input-group system-inputs" style="display:none;">
      <div>
        <input type="text" id="sys-eq1" placeholder="Ec. 1 (ej: 2x + y = 7)" value="2x + y = 7">
      </div>
      <div>
        <input type="text" id="sys-eq2" placeholder="Ec. 2 (ej: x - y = 2)" value="x - y = 2">
      </div>
    </div>

    <div style="text-align: center;">
      <button class="btn-calc">Calcular y Representar</button>
    </div>

    <div id="result" class="result-display">Resultado: x² + 3x + 2</div>
  </div>

  <div id="algebra-frame">
    <div class="corner" id="corner-symbol">×</div>
    <div id="axis-top" class="axis"><div class="tile tile-x-vert" style="left: 8px; top: 8px;">x</div><div class="tile tile-1" style="left: 78px; top: 8px;">1</div><div class="tile tile-1" style="left: 104px; top: 8px;">1</div></div>
    <div id="axis-left" class="axis"><div class="tile tile-x-horiz" style="left: 8px; top: 8px;">x</div><div class="tile tile-1" style="left: 8px; top: 78px;">1</div></div>
    <div id="board"><div class="tile tile-x2" style="left: 8px; top: 8px;">x²</div><div class="tile tile-x-horiz" style="left: 78px; top: 8px;">x</div><div class="tile tile-x-horiz" style="left: 104px; top: 8px;">x</div><div class="tile tile-x-vert" style="left: 8px; top: 78px;">x</div><div class="tile tile-1" style="left: 78px; top: 78px;">1</div><div class="tile tile-1" style="left: 104px; top: 78px;">1</div></div>
  </div>

  


</body></html>
