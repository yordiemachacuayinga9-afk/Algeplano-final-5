@charset "utf-8";

* { box-sizing: border-box; font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif; }

body { display: flex; flex-direction: column; align-items: center; background-color: rgb(15, 23, 42); color: rgb(248, 250, 252); margin: 0px; padding: 15px; min-height: 100vh; }

h1 { margin: 5px 0px 10px; font-size: 24px; color: rgb(56, 189, 248); text-align: center; }

#btn-install { background: linear-gradient(135deg, rgb(16, 185, 129), rgb(5, 150, 105)); color: white; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 10px 18px; border-radius: 20px; font-weight: bold; cursor: pointer; margin-bottom: 15px; display: none; box-shadow: rgba(16, 185, 129, 0.4) 0px 4px 12px; }

.calc-panel { background: rgb(30, 41, 59); padding: 15px; border-radius: 12px; box-shadow: rgba(0, 0, 0, 0.3) 0px 10px 25px; width: 100%; max-width: 900px; margin-bottom: 15px; border: 1px solid rgb(51, 65, 85); }

.input-group { display: flex; gap: 10px; align-items: center; justify-content: center; flex-wrap: wrap; margin-bottom: 10px; }

.system-inputs { display: flex; flex-direction: column; gap: 8px; align-items: center; width: 100%; }

input, select { padding: 10px 14px; border-radius: 8px; border: 1px solid rgb(71, 85, 105); background-color: rgb(15, 23, 42); color: rgb(255, 255, 255); font-size: 16px; outline: none; }

button.btn-calc { padding: 10px 20px; background-color: rgb(2, 132, 199); color: white; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 8px; font-size: 16px; font-weight: bold; cursor: pointer; transition: background 0.2s; width: 100%; max-width: 300px; }

.result-display { background: rgb(15, 23, 42); padding: 12px; border-radius: 8px; text-align: center; font-size: 16px; font-weight: bold; color: rgb(74, 222, 128); border: 1px solid rgb(34, 197, 94); margin-top: 10px; line-height: 1.5; }

.steps-box { text-align: left; font-weight: normal; font-size: 14px; color: rgb(203, 213, 225); margin-top: 8px; background: rgb(30, 41, 59); padding: 10px; border-radius: 6px; }

#algebra-frame { display: grid; grid-template-columns: 80px 1fr; grid-template-rows: 80px 1fr; gap: 8px; width: 100%; max-width: 900px; background-color: rgb(30, 41, 59); padding: 10px; border-radius: 12px; box-shadow: rgba(0, 0, 0, 0.3) 0px 10px 25px; border: 1px solid rgb(51, 65, 85); }

.corner { background-color: rgb(51, 65, 85); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: bold; color: rgb(148, 163, 184); }

.axis { background-color: rgb(15, 23, 42); border: 2px dashed rgb(71, 85, 105); border-radius: 8px; position: relative; overflow: hidden; }

#axis-top { grid-area: 1 / 2; }

#axis-left { grid-area: 2 / 1; min-height: 320px; }

#board { grid-area: 2 / 2; background-color: rgb(15, 23, 42); border: 2px solid rgb(51, 65, 85); border-radius: 8px; position: relative; min-height: 320px; overflow: hidden; }

.tile { position: absolute; display: flex; align-items: center; justify-content: center; font-weight: bold; color: white; border-radius: 4px; box-shadow: rgba(0, 0, 0, 0.3) 0px 2px 5px; border: 1px solid rgba(255, 255, 255, 0.2); }

.tile-x2 { width: 65px; height: 65px; background-color: rgb(37, 99, 235); font-size: 15px; }

.tile-x-vert { width: 65px; height: 22px; background-color: rgb(22, 163, 74); font-size: 13px; }

.tile-x-horiz { width: 22px; height: 65px; background-color: rgb(22, 163, 74); font-size: 13px; }

.tile-y-vert { width: 65px; height: 22px; background-color: rgb(168, 85, 247); font-size: 13px; }

.tile-1 { width: 22px; height: 22px; background-color: rgb(234, 88, 12); font-size: 12px; }
